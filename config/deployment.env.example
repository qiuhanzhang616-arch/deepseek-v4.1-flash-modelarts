# Copy to config/deployment.env and replace every value marked CHANGE_ME.
# Never commit config/deployment.env.

# Huawei Cloud public-cloud identity and API endpoint.
MODELARTS_ENDPOINT=https://modelarts.CHANGE_ME_REGION.myhuaweicloud.com
HUAWEICLOUD_PROJECT_ID=CHANGE_ME_PROJECT_ID
WORKSPACE_ID=0

# ModelArts dedicated inference resource pool.
POOL_ID=CHANGE_ME_POOL_ID
A2_8_CARD_FLAVOR=CHANGE_ME_8X_A2_FLAVOR

# Private SWR image URI after mirroring the pinned upstream image.
SWR_IMAGE_URI=CHANGE_ME_SWR_REGISTRY/CHANGE_ME_ORGANIZATION/CHANGE_ME_REPOSITORY:deepseek-v4.1-flash-521f866a

# SFS Turbo must be in the same region and associated with the dedicated pool.
SFS_TURBO_ID=CHANGE_ME_SFS_TURBO_ID
SFS_SUB_PATH=/CHANGE_ME_SFS_DIRECTORY

# Service settings.
SERVICE_NAME=deepseek-v41-flash-a2-1m
DEPLOYMENT_NAME=deepseek-v41-a2
INTERNET_ACCESS_ENABLED=false
INTRANET_APPROVAL_ENABLED=true
