# C5 differs from C4 only by disabling speculative decoding.
# SP_TOKENS remains 5 but is inert when SPEC=0 in the pinned serve_v2.sh.
CANDIDATE_ID=w4a8-c5-1m-single-replica-nospec
MODEL_PATH=/model/w4a8/model-view
MODEL_NAME=deepseek-v4.1-flash
SERVICE_PORT=8000
MAX_LEN=1048576
MAX_SEQS=32
BAT_TOKENS=8192
GPU_UTIL=0.92
PREFIX=1
SPEC=0
SP_TOKENS=5
DRAFT_GRAPH=0
ENGRAM=1
ENGRAM_STORAGE=int8
V41_ENGRAM_DEVICE_INDEX=0
TOOL_CALLING=1
DEFAULT_REASONING_EFFORT=low
